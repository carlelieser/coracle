# Config deltas applied on top of arm64 defconfig via merge_config.sh.
#
# Three jobs:
#   1. Turn on what the machine model actually provides (virtio-mmio, PL011,
#      GICv2, PSCI, 9p, overlayfs, ext4).
#   2. Turn off ISA extensions the feature mask does not advertise. A kernel
#      built expecting LSE atomics does not run on our CPU model.
#   3. Strip drivers for hardware that does not exist, so boot is short and the
#      image is small.

# --- Platform -----------------------------------------------------------
# ARCH_VIRT is the QEMU `virt` machine we clone. Every other platform goes.
CONFIG_ARCH_VIRT=y
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_48=y
CONFIG_ARM64_PA_BITS_48=y

# Single vCPU: SMP is a v1 non-goal. Left on because arm64 defconfig cannot
# build without it and the DT declares exactly one cpu node. NR_CPUS has a
# floor of 2 in arm64 Kconfig, so the DT's single cpu node is what actually
# holds this to one; dmesg confirms "Brought up 1 node, 1 CPU".
CONFIG_SMP=y
CONFIG_NR_CPUS=2
# No CPU hotplug: nothing ever offlines the single vCPU.
# CONFIG_HOTPLUG_CPU is not set

# AArch64 only. No 32-bit EL0 — halves the exception surface we must emulate.
# CONFIG_COMPAT is not set

# --- Firmware / PSCI ----------------------------------------------------
# PSCI over trapped SMC is our only firmware interface: boot, reboot, poweroff.
CONFIG_ARM_PSCI_FW=y
CONFIG_ARM64_ACPI_PARKING_PROTOCOL=n
# No EL2/EL3, so no KVM and no Spectre/EL2 firmware workarounds to negotiate.
# CONFIG_VIRTUALIZATION is not set
# CONFIG_KVM is not set

# --- Interrupt controller and timer -------------------------------------
CONFIG_ARM_GIC=y
CONFIG_ARM_GIC_V2M=y
# GICv3/v4 hardware does not exist on this machine.
# CONFIG_ARM_GIC_V3 is not set
# CONFIG_ARM_GIC_V3_ITS is not set
CONFIG_ARM_ARCH_TIMER=y
CONFIG_ARM_ARCH_TIMER_EVTSTREAM=y

# --- ISA extensions: must match the advertised feature mask -------------
# The emulator advertises none of these. Building them in makes the kernel
# either use them unconditionally or spend boot probing for them.
#
# LSE: ARM64_LSE_ATOMICS has no prompt — it is `default ARM64_USE_LSE_ATOMICS`.
# Disabling the user-visible symbol is what actually turns it off. With it set,
# the in-kernel atomics are alternative-patched to CAS/LDADD at boot when
# HWCAP_ATOMICS is present; our CPU model never sets that bit, but building
# without it removes the patch sites altogether.
# CONFIG_ARM64_USE_LSE_ATOMICS is not set
# CONFIG_ARM64_LSE_ATOMICS is not set
# CONFIG_ARM64_SVE is not set
# CONFIG_ARM64_SME is not set
# CONFIG_ARM64_MTE is not set
# CONFIG_ARM64_PTR_AUTH is not set
# CONFIG_ARM64_PTR_AUTH_KERNEL is not set
# CONFIG_ARM64_BTI is not set
# CONFIG_ARM64_BTI_KERNEL is not set
# CONFIG_ARM64_E0PD is not set
# CONFIG_ARM64_EPAN is not set
# CONFIG_ARM64_TLB_RANGE is not set
# CONFIG_ARM64_AMU_EXTN is not set
# CONFIG_ARM64_PMEM is not set
# CONFIG_ARM64_RAS_EXTN is not set
# CONFIG_ARM64_CNP is not set
# CONFIG_ARM64_HW_AFDBM is not set

# ARMv8.0 crypto extensions are not advertised; the accelerated drivers would
# fault. Generic C implementations stay in for whatever needs them.
#
# KERNEL_MODE_NEON is `def_bool y` on arm64 and cannot be turned off. That is
# fine: it only enables kernel_neon_begin/end, and plain FP/AdvSIMD is part of
# ARMv8.0-A, which we do advertise. What must stay off is the crypto-extension
# code below, which needs FEAT_AES/FEAT_SHA.
# CONFIG_ARM64_CRYPTO is not set
# CONFIG_CRYPTO_AES_ARM64 is not set
# CONFIG_CRYPTO_AES_ARM64_CE is not set
# CONFIG_CRYPTO_AES_ARM64_CE_BLK is not set
# CONFIG_CRYPTO_AES_ARM64_CE_CCM is not set
# CONFIG_CRYPTO_AES_ARM64_NEON_BLK is not set
# CONFIG_CRYPTO_SHA1_ARM64_CE is not set
# CONFIG_CRYPTO_SHA2_ARM64_CE is not set
# CONFIG_CRYPTO_SHA256_ARM64 is not set
# CONFIG_CRYPTO_SHA512_ARM64 is not set
# CONFIG_CRYPTO_SHA512_ARM64_CE is not set
# CONFIG_CRYPTO_SHA3_ARM64 is not set
# CONFIG_CRYPTO_SM3_ARM64_CE is not set
# CONFIG_CRYPTO_SM4_ARM64_CE is not set
# CONFIG_CRYPTO_GHASH_ARM64_CE is not set
# CONFIG_CRYPTO_CRCT10DIF_ARM64_CE is not set
# CONFIG_CRYPTO_POLY1305_NEON is not set
# CONFIG_CRYPTO_CHACHA20_NEON is not set
# CONFIG_CRYPTO_NHPOLY1305_NEON is not set

# Erratum workarounds target real silicon; our CPU model has none of these bugs
# and several workarounds emit instructions outside the feature mask.
# CONFIG_ARM64_ERRATUM_858921 is not set
# CONFIG_ARM64_ERRATUM_1418040 is not set
# CONFIG_ARM64_ERRATUM_1542419 is not set
# CONFIG_ARM64_ERRATUM_2054223 is not set
# CONFIG_ARM64_ERRATUM_2077057 is not set

# --- Console ------------------------------------------------------------
# console=ttyAMA0 on the PL011 at 0x9000000.
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_OF_PLATFORM=y
# No 8250 on this machine.
# CONFIG_SERIAL_8250 is not set

# --- virtio -------------------------------------------------------------
# mmio transport only; there is no PCI virtio on our machine.
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
# QEMU's virt places virtio-mmio slots in the DT, so no cmdline probing needed,
# but the emulator's generated DT uses the same slots and this costs nothing.
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
# CONFIG_VIRTIO_PCI is not set
# CONFIG_VIRTIO_BALLOON is not set

# --- Filesystems --------------------------------------------------------
# 9p is the root lower layer (merged OCI layers served from JS).
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y
# xattr + security xattr are what overlayfs needs from the lower layer for
# whiteouts and opaque dirs.
CONFIG_9P_FS_SECURITY=y

# overlayfs merges the 9p lower with the ext4 upper; the kernel owns copy-up,
# whiteouts and rename.
CONFIG_OVERLAY_FS=y
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
CONFIG_OVERLAY_FS_XINO_AUTO=y
CONFIG_OVERLAY_FS_METACOPY=y

# ext4 is the writable upper on virtio-blk — real xattrs, uid/gid, hardlinks.
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_EXT4_USE_FOR_EXT2=y

# Pseudo-filesystems the guest init mounts.
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Generic xattr/ACL plumbing the above depend on.
CONFIG_FS_POSIX_ACL=y
CONFIG_TMPFS_INODE64=y

# --- initramfs ----------------------------------------------------------
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
# One decompressor is enough; the build produces gzip.
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set

# --- Networking ---------------------------------------------------------
# Enough for virtio-net to a userspace TCP/IP stack over the relay (M3).
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
# IPv6 is not part of the relay protocol.
# CONFIG_IPV6 is not set

# --- Hardware that does not exist on this machine ------------------------
# Non-goals from the plan: no GPU/framebuffer, no USB.
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_FB_CORE is not set
# CONFIG_BACKLIGHT_CLASS_DEVICE is not set
# CONFIG_VGA_CONSOLE is not set
# CONFIG_DUMMY_CONSOLE is not set
# CONFIG_LOGO is not set
# CONFIG_SOUND is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_INPUT_MOUSEDEV is not set
# CONFIG_INPUT_JOYDEV is not set
# CONFIG_INPUT_EVDEV is not set

# The DT has a pcie node inherited from `virt`, but the emulator implements no
# PCI devices. Leaving the host controller out keeps boot from probing ECAM.
# CONFIG_PCI is not set
# CONFIG_PCI_HOST_GENERIC is not set

# No physical storage controllers.
# CONFIG_ATA is not set
# CONFIG_SCSI is not set
# CONFIG_MD is not set
# CONFIG_MMC is not set
# CONFIG_MTD is not set

# Buses and management interfaces with nothing attached. Each of these prints a
# probe line at boot and finds nothing; the DT declares none of them.
# CONFIG_I2C is not set
# CONFIG_SPI is not set
# CONFIG_IPMI_HANDLER is not set
# CONFIG_IIO is not set
# CONFIG_GNSS is not set
# CONFIG_VFIO is not set
# CONFIG_CORESIGHT is not set
# CONFIG_HWMON is not set
# CONFIG_THERMAL is not set
# CONFIG_WATCHDOG is not set
# CONFIG_PWM is not set
# CONFIG_RESET_CONTROLLER is not set
# CONFIG_NVMEM is not set
# CONFIG_EXTCON is not set
# CONFIG_MAILBOX is not set
# CONFIG_REMOTEPROC is not set
# CONFIG_RPMSG is not set
# CONFIG_DEVFREQ is not set
# CONFIG_MEMORY is not set
# CONFIG_DMADEVICES is not set
# CONFIG_VIRTIO_IOMMU is not set
# CONFIG_ARM_SMMU is not set
# CONFIG_IOMMU_SUPPORT is not set

# CMA exists for large contiguous DMA buffers, which only a camera or GPU
# needs. Leaving it on reserves 32 MB of the guest's 1 GB for nothing.
# CONFIG_CMA is not set
# CONFIG_DMA_CMA is not set

# Subsystems with no device and no user in this machine.
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_VIDEO_DEV is not set
# CONFIG_NFC is not set
# CONFIG_EDAC is not set
# CONFIG_FPGA is not set
# CONFIG_ARM_SCMI_PROTOCOL is not set
# CONFIG_ARM_SCPI_PROTOCOL is not set
# CONFIG_PPS is not set
# CONFIG_PTP_1588_CLOCK is not set
# CONFIG_NEW_LEDS is not set
# CONFIG_LEDS_TRIGGERS is not set
# CONFIG_ASYMMETRIC_KEY_TYPE is not set
# CONFIG_BLK_DEV_BSG is not set

# One I/O scheduler is enough for a single virtio-blk queue.
# CONFIG_IOSCHED_BFQ is not set
# CONFIG_MQ_IOSCHED_KYBER is not set

# Serial drivers for other vendors' SoCs. The console is PL011.
# CONFIG_SERIAL_MSM is not set
# CONFIG_SERIAL_SH_SCI is not set
# CONFIG_SERIAL_STM32 is not set
# CONFIG_SERIAL_AMBA_PL010 is not set
# CONFIG_SERIAL_SAMSUNG is not set
# CONFIG_SERIAL_XILINX_PS_UART is not set

# Network devices with no backing hardware. virtio-net is the only interface.
# CONFIG_TUN is not set
# CONFIG_MACVLAN is not set
# CONFIG_VXLAN is not set
# CONFIG_NLMON is not set
# CONFIG_NET_TEAM is not set
# CONFIG_BONDING is not set
# CONFIG_DUMMY is not set
# CONFIG_PHYLIB is not set
# CONFIG_MDIO_DEVICE is not set

# No loop device: the root is overlayfs over 9p and virtio-blk, never an image
# file mounted from inside the guest.
# CONFIG_BLK_DEV_LOOP is not set
# CONFIG_BLK_DEV_NBD is not set
# CONFIG_BLK_DEV_RAM is not set
# CONFIG_ZRAM is not set

# No power management: the vCPU never idles into a real C-state, and
# CPU_SUSPEND is handled as WFI by our PSCI subset.
# CONFIG_CPU_FREQ is not set
# CONFIG_CPU_IDLE is not set
# CONFIG_SUSPEND is not set
# CONFIG_HIBERNATION is not set
# CONFIG_PM is not set

# No wireless, no bluetooth, no CAN.
# CONFIG_WIRELESS is not set
# CONFIG_BT is not set
# CONFIG_CAN is not set
# CONFIG_RFKILL is not set

# --- RTC ----------------------------------------------------------------
# PL031 at 0x9010000 gives the guest a wall clock at boot.
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_PL031=y
CONFIG_RTC_HCTOSYS=y

# --- GPIO ---------------------------------------------------------------
# The `virt` DT wires a PL061 to a gpio-keys poweroff button. PSCI SYSTEM_OFF is
# our poweroff path, so the driver is not needed; without it the DT node is
# simply unclaimed, which is not an error.
# CONFIG_GPIOLIB is not set

# --- Size and boot time -------------------------------------------------
# No modules: everything needed is built in, so there is no module loader, no
# depmod step, and no /lib/modules in the initramfs.
# CONFIG_MODULES is not set

# Debug/tracing machinery costs boot time and image size. The differential
# harness reads state from the emulator, not from in-kernel tracing.
# CONFIG_FTRACE is not set
# CONFIG_KPROBES is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_DEBUG_INFO is not set
CONFIG_DEBUG_INFO_NONE=y

# Deterministic boot: KASLR would move the kernel each run, which makes the
# M2 differential trace against QEMU non-reproducible.
# CONFIG_RANDOMIZE_BASE is not set

# The DT is authoritative and passed explicitly; never let a bootloader-supplied
# or built-in cmdline override it silently.
CONFIG_CMDLINE=""
# CONFIG_CMDLINE_FORCE is not set

# Kernel is loaded and run directly; no EFI stub, no bootloader.
# CONFIG_EFI is not set
# CONFIG_ACPI is not set
CONFIG_OF=y

# EXPERT exposes the symbols below for trimming; without it kconfig forces
# several of them back on.
CONFIG_EXPERT=y

# KALLSYMS_ALL adds every symbol, not just functions, to the image. Plain
# KALLSYMS is kept so an oops in the M2 differential runs is still readable.
# CONFIG_KALLSYMS_ALL is not set

# --- Networking the relay does not use --------------------------------
# virtio-net hands frames to a userspace TCP/IP stack (M3); the kernel does no
# filtering, bridging or tunnelling of its own.
# CONFIG_NETFILTER is not set
# CONFIG_BRIDGE is not set
# CONFIG_VLAN_8021Q is not set
# CONFIG_NET_SCHED is not set
# CONFIG_NET_CLS is not set
# CONFIG_IP_MULTICAST is not set
# CONFIG_IP_ADVANCED_ROUTER is not set
# CONFIG_INET_TUNNEL is not set
# CONFIG_INET_ESP is not set
# CONFIG_INET_AH is not set
# CONFIG_INET_IPCOMP is not set
# CONFIG_XFRM_USER is not set
# CONFIG_WLAN is not set
# CONFIG_ETHERNET is not set
# CONFIG_WIREGUARD is not set
# CONFIG_VSOCKETS is not set

# --- Crypto ------------------------------------------------------------
# Nothing in the boot path needs the crypto API: no dm-crypt, no IPsec, no
# module signing, no fscrypt. The core is left in because a handful of
# subsystems link against it, but the algorithm zoo goes.
# CONFIG_CRYPTO_USER is not set
# CONFIG_CRYPTO_RSA is not set
# CONFIG_CRYPTO_DH is not set
# CONFIG_CRYPTO_ECDH is not set
# CONFIG_CRYPTO_ECDSA is not set
# CONFIG_CRYPTO_DES is not set
# CONFIG_CRYPTO_XTS is not set
# CONFIG_CRYPTO_CCM is not set
# CONFIG_CRYPTO_GCM is not set
# CONFIG_CRYPTO_CMAC is not set
# CONFIG_CRYPTO_XXHASH is not set
# CONFIG_CRYPTO_ZSTD is not set
# CONFIG_CRYPTO_LZO is not set
# CONFIG_CRYPTO_DEFLATE is not set
# CONFIG_CRYPTO_USER_API_HASH is not set
# CONFIG_CRYPTO_USER_API_SKCIPHER is not set

# --- Filesystems we never mount ----------------------------------------
# The root is overlayfs(9p, ext4); the initramfs is the only other tree.
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_CIFS is not set
# CONFIG_FUSE_FS is not set
# CONFIG_SQUASHFS is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_FAT_FS is not set
# CONFIG_NTFS3_FS is not set
# CONFIG_HUGETLBFS is not set
# CONFIG_QUOTA is not set
# CONFIG_FS_ENCRYPTION is not set
# CONFIG_FS_VERITY is not set

# --- Kernel features the container runtime does not use ------------------
# The plan's container runtime is a tiny init that execs: no runc, no cgroups,
# no namespaces.
# CONFIG_CGROUPS is not set
# CONFIG_NAMESPACES is not set
# CONFIG_SECCOMP is not set
# CONFIG_AUDIT is not set
# CONFIG_SECURITY is not set
# CONFIG_SECURITY_SELINUX is not set
# CONFIG_SECURITY_APPARMOR is not set
# CONFIG_INTEGRITY is not set
# CONFIG_KEXEC is not set
# CONFIG_CRASH_DUMP is not set
# CONFIG_PROFILING is not set
# CONFIG_PERF_EVENTS is not set
# CONFIG_NUMA is not set
# CONFIG_TRANSPARENT_HUGEPAGE is not set
# CONFIG_ZSWAP is not set
# CONFIG_SWAP is not set
