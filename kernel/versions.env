# Pinned versions for the guest kernel and initramfs.
# Every milestone boots this exact kernel; M5 publishes a snapshot per KERNEL_VERSION.
# Changing any value here is a deliberate, reviewed act.

# Linux 6.12 LTS. Chosen over a newer stable so the pin stays supported across
# the whole milestone sequence.
KERNEL_VERSION=6.12.108
KERNEL_SHA256=e1d1ea200d22d55c9f5d5fae59e69bb3b494515705fc3390cd54231ee4f4baaf
KERNEL_URL=https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-6.12.108.tar.xz

BUSYBOX_VERSION=1.37.0
BUSYBOX_SHA256=3311dff32e746499f4df0d5df04d7eb396382d7e108bb9250e7b519b837043a4
BUSYBOX_URL=https://busybox.net/downloads/busybox-1.37.0.tar.bz2

# Build container. Pinned by digest-bearing tag so a rebuild is reproducible.
BUILDER_IMAGE=coracle-kernel-builder:6.12.108

# Reference oracle. The differential harness (M0) pins its own copy; these two
# must agree before the harness lands.
QEMU_VERSION=11.1.1
