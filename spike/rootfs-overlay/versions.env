# Pinned versions for the M0 rootfs spike.
# Changing any of these invalidates RESULTS.md; re-run and re-record.

KERNEL_VERSION=6.12.107
KERNEL_SHA256=a5f8c5be3fde2d6d9ca14e9631642cf1f44487143f11059da730dcd5892e307a
KERNEL_URL=https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-${KERNEL_VERSION}.tar.xz

# busybox comes prebuilt-static from Alpine rather than from source: 1.37.0
# does not compile against GCC 12 on aarch64 (libbb/hash_md5_sha.c fails on an
# undeclared sha1_process_block64). Alpine ships the patched build, and the
# guest shell is not what this spike is measuring.
BUSYBOX_VERSION=1.37.0
BUSYBOX_IMAGE=alpine:3.21

# Build container: provides the aarch64-native GCC toolchain. Host is arm64 so
# this is a native build inside a linux/arm64 container, not a cross-compile.
BUILDER_IMAGE=debian:bookworm-slim

# QEMU runs INSIDE a linux/arm64 container, not on the macOS host. The lower
# layer served over 9p must carry real Linux ownership and user.* xattrs;
# a Docker bind mount to macOS silently drops both (chown reports success and
# does not take effect, setfattr returns EOPNOTSUPP), which would fail the
# uid/gid and xattr cases for a host reason rather than a kernel one.
RUNNER_IMAGE=debian:trixie-slim
QEMU_VERSION=10.0.11

